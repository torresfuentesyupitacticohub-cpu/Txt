        local car = FindVehicle()
        if car then
            local pos = car:GetPivot().Position
            status.Text = string.format("X: %.1f\nY: %.1f\nZ: %.1f", pos.X, pos.Y, pos.Z)
        end
    end)
    
    CarSnapSystem.GuideFrame = screenGui
end

-- ==========================================
-- FARM SPEED SYSTEM (Solo al mover)
-- ==========================================
local FarmSpeedSystem = {
    Enabled = false,
    Speed = 100,
    Connection = nil,
    IsMoving = false
}

local lastCarPos = nil

local function startFarmSpeed()
    if FarmSpeedSystem.Connection then
        FarmSpeedSystem.Connection:Disconnect()
    end
    
    FarmSpeedSystem.Connection = RunService.Heartbeat:Connect(function()
        if not FarmSpeedSystem.Enabled then return end
        
        local chassis = getChassis()
        if not chassis then return end
        
        -- Detectar si se estÃ¡ moviendo
        if lastCarPos then
            local dist = (chassis.Position - lastCarPos).Magnitude
            FarmSpeedSystem.IsMoving = dist > 0.5
        end
        
        lastCarPos = chassis.Position
        
        -- Solo aplicar velocidad si se estÃ¡ moviendo
        if FarmSpeedSystem.IsMoving then
            local direction = chassis.CFrame.LookVector
            chassis.AssemblyLinearVelocity = direction * FarmSpeedSystem.Speed
        end
    end)
end

local function stopFarmSpeed()
    FarmSpeedSystem.Enabled = false
    if FarmSpeedSystem.Connection then
        FarmSpeedSystem.Connection:Disconnect()
        FarmSpeedSystem.Connection = nil
    end
end

-- ==========================================
-- BUMP AURA SYSTEM (FUNCIONAL)
-- ==========================================
local BumpAuraSystem = {
    Enabled = false,
    Range = 100,
    Power = 150,
    Connection = nil
}

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local SendRemote = Remotes:FindFirstChild("Send")

local function startBumpAura()
    if BumpAuraSystem.Connection then
        BumpAuraSystem.Connection:Disconnect()
    end
    
    BumpAuraSystem.Connection = RunService.Heartbeat:Connect(function()
        if not BumpAuraSystem.Enabled then return end
        
        local car = FindVehicle()
        if not car then return end
        
        local myChar = LocalPlayer.Character
        if not myChar or not myChar.PrimaryPart then return end
        
        for _, target in ipairs(Players:GetPlayers()) do
            if target ~= LocalPlayer and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = target.Character.HumanoidRootPart
                local dist = (hrp.Position - myChar.PrimaryPart.Position).Magnitude
                
                if dist < BumpAuraSystem.Range then
                    -- Aplicar velocidad al auto hacia el jugador
                    local direction = (hrp.Position - car:GetPivot().Position).Normalized
                    local velocity = direction * BumpAuraSystem.Power
                    
                    for _, part in ipairs(car:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.AssemblyLinearVelocity = velocity
                        end
                    end
                end
            end
        end
    end)
end

local function stopBumpAura()
    BumpAuraSystem.Enabled = false
    if BumpAuraSystem.Connection then
        BumpAuraSystem.Connection:Disconnect()
        BumpAuraSystem.Connection = nil
    end
end

