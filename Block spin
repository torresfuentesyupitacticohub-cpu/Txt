-- Поиск ближайшей цели
local function getClosestTarget()
    local closest
    local minDist = FOV
    local screenCenter = Vector2.new(workspace.CurrentCamera.ViewportSize.X / 2, workspace.CurrentCamera.ViewportSize.Y / 2)
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local head = player.Character:FindFirstChild("Head")
            local hum = player.Character:FindFirstChild("Humanoid")
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if head and hum and hum.Health > 0 and hrp then
                local screenPos, onScreen = workspace.CurrentCamera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                    if dist <= FOV and not isPlayerExcluded(player.Name) then
                        if dist < minDist then
                            minDist = dist
                            closest = player
                        end
                    end
                end
            end
        end
    end
    return closest
end

-- Сглаженный пинг
local function GetSmoothedPing()
    local Stats = game:GetService("Stats")
    local PingStats = Stats.Network.ServerStatsItem["Data Ping"]
    local pingValue = PingStats:GetValue()
    table.insert(PingHistory, pingValue)
    if #PingHistory > MaxHistory then
        table.remove(PingHistory, 1)
    end
    local sum = 0
    for _, val in ipairs(PingHistory) do
        sum = sum + val
    end
    return (sum / #PingHistory) / 1000
end

-- Предсказание позиции
local function predictPosition(part, hrp)
    if not part then return Vector3.zero end
    local ping = GetSmoothedPing()
    if ping > 1 then ping = ping + 0.15 end
    local velocity = (hrp and hrp.AssemblyLinearVelocity) or Vector3.zero
    return part.Position + (velocity * ping * 1)
end

-- Проверка на стену
local function isBehindWall(fromPos, toPos)
    local direction = toPos - fromPos
    if direction.Magnitude < 1 then return false end
    local ignore = {}
    local char = LocalPlayer.Character
    if char then table.insert(ignore, char) end
    local targetChar = CurrentTarget and CurrentTarget.Character
    if targetChar then table.insert(ignore, targetChar) end
    local ray = workspace:Raycast(fromPos, direction, RaycastParams.new())
    if not ray then return false end
    local hit = ray.Instance
    return hit and not table.find(ignore, hit.Parent)
end

