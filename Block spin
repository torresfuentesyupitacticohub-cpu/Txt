local function getRarityColor(item)
    if item.Name == "Money" then return Color3.fromRGB(0, 255, 0) end
    for _, folder in ipairs(Items:GetChildren()) do
        if folder:IsA("Folder") then
            local itemTemplate = folder:FindFirstChild(item.Name)
            if itemTemplate and itemTemplate:GetAttribute("RarityName") then
                local rarity = itemTemplate:GetAttribute("RarityName")
                return RarityColors[rarity] or Color3.fromRGB(255, 255, 255)
            end
        end
    end
    return Color3.fromRGB(255, 255, 255)
end

local itemDrawings = {}

local function cleanupItemDrawings()
    for item, data in pairs(itemDrawings) do
        if not item or not item.Parent then
            if data.circle then pcall(function() data.circle:Remove() end) end
            if data.innerCircle then pcall(function() data.innerCircle:Remove() end) end
            if data.name then pcall(function() data.name:Remove() end) end
            if data.amount then pcall(function() data.amount:Remove() end) end
            if data.highlight then pcall(function() data.highlight:Destroy() end) end
            itemDrawings[item] = nil
        end
    end
end

RunService.RenderStepped:Connect(function()
    cleanupItemDrawings()
    if not DroppedItems then return end
    local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end
    for _, data in pairs(itemDrawings) do
        data.circle.Visible = false
        data.innerCircle.Visible = false
        data.name.Visible = false
        data.amount.Visible = false
        if data.highlight then data.highlight.Enabled = false end
    end
    local items = {}
    for _, item in ipairs(DroppedItems:GetChildren()) do
        if item:IsA("Model") and item:FindFirstChild("PickUpZone") and not item:GetAttribute("Locked") then
            local success, pos = pcall(function() return item.PickUpZone.Position end)
            if success and pos then
                local dist = (pos - myHrp.Position).Magnitude
                table.insert(items, {item = item, dist = dist})
            end
        end
    end
    table.sort(items, function(a, b) return a.dist < b.dist end)
    for i = 1, math.min(20, #items) do
        local item = items[i].item
        local data = itemDrawings[item]
        if not data then
            data = {
                circle = Drawing.new("Circle"),
                innerCircle = Drawing.new("Circle"),
                name = Drawing.new("Text"),
                amount = Drawing.new("Text")
            }
            data.circle.Thickness = 2
            data.circle.Transparency = 0.7
            data.circle.Filled = false
            data.innerCircle.Thickness = 2
            data.innerCircle.Transparency = 1
            data.innerCircle.Filled = true
            data.name.Outline = true
            data.name.OutlineColor = Color3.fromRGB(0, 0, 0)
            data.name.Center = true
            data.name.Size = 16
            data.name.Font = 4
            data.amount.Outline = true
            data.amount.OutlineColor = Color3.fromRGB(0, 0, 0)
            data.amount.Center = true
            data.amount.Size = 13
            data.amount.Color = Color3.fromRGB(200, 200, 200)
            itemDrawings[item] = data
        end
        if not data.highlight or not data.highlight.Parent then
            local highlight = Instance.new("Highlight")
            highlight.Name = "ESP_Highlight"
            highlight.FillTransparency = 0.5
            highlight.OutlineTransparency = 0.1
            highlight.Adornee = item
            highlight.Parent = item
            data.highlight = highlight
        end
        local screenPos, onScreen = camera:WorldToViewportPoint(item.PickUpZone.Position)
        if onScreen then
            local color = getRarityColor(item)
            local radius = math.clamp(100 / screenPos.Z, 3, 6)
            if data.highlight then
                data.highlight.FillColor = color
                data.highlight.OutlineColor = color
                data.highlight.Enabled = true
            end
            data.circle.Position = Vector2.new(screenPos.X, screenPos.Y)
            data.circle.Radius = radius + 5
            data.circle.Color = color
            data.circle.Visible = true
            data.innerCircle.Position = Vector2.new(screenPos.X, screenPos.Y)
            data.innerCircle.Radius = radius
            data.innerCircle.Color = color
            data.innerCircle.Visible = true
            data.name.Color = color
            data.name.Position = Vector2.new(screenPos.X, screenPos.Y - radius - 20)
            data.name.Text = item.Name
            data.name.Visible = true
            local amount = item:GetAttribute("Amount") or 1
            data.amount.Position = Vector2.new(screenPos.X, screenPos.Y + radius + 15)
            data.amount.Text = amount > 1 and "[" .. tostring(amount) .. "]" or ""
            data.amount.Visible = amount > 1
        else
            data.circle.Visible = false
            data.innerCircle.Visible = false
            data.name.Visible = false
            data.amount.Visible = false
            if data.highlight then data.highlight.Enabled = false end
        end
    end
end)

