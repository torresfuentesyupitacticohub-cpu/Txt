                local ownerId = vehicle:GetAttribute("OwnerUserId")
                if ownerId and ownerId == LocalPlayer.UserId then
                    local offset = CFrame.new(math.random(-5, 5), 3, math.random(-15, -5))
                    if vehicle.PrimaryPart then
                        vehicle:SetPrimaryPartCFrame(hrp.CFrame * offset)
                    else
                        local part = vehicle:FindFirstChildWhichIsA("BasePart")
                        if part then part.CFrame = hrp.CFrame * offset end
                    end
                end
            end
        end
        if WindUI then WindUI:Notify({Title = "Car", Desc = "Vehicle pulled", Duration = 3}) end
    end
})

