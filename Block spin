-- ==================== CONFIG MANAGEMENT ====================
local CONFIG_FOLDER = "rickHub"
local CONFIG_FILE = CONFIG_FOLDER .. "/config.json"

pcall(function()
    if not isfolder(CONFIG_FOLDER) then makefolder(CONFIG_FOLDER) end
end)

_G.RegisteredElements = _G.RegisteredElements or {}

function RegisterElement(key, element, elementType, callback)
    _G.RegisteredElements[key] = {element = element, type = elementType, callback = callback}
end

local function CollectValues()
    local data = {}
    for key, entry in pairs(_G.RegisteredElements) do
        local el = entry.element
        if el then
            local ok, val = pcall(function() return el.Value end)
            if ok and val ~= nil then
                data[key] = {type = entry.type, value = val}
            end
        end
    end
    return data
end

local function ApplyValues(data)
    if not data then return end
    for key, entry in pairs(data) do
        local reg = _G.RegisteredElements[key]
        if reg and reg.element then
            local el = reg.element
            local val = entry.value
            pcall(function()
                if el.Set then el:Set(val)
                elseif el.Value ~= nil then el.Value = val end
            end)
            if reg.callback then pcall(reg.callback, val) end
        end
    end
end

local function SaveConfig()
    local data = CollectValues()
    local json = HttpService:JSONEncode(data)
    local ok, err = pcall(function() writefile(CONFIG_FILE, json) end)
    if ok then
        if WindUI then WindUI:Notify({Title = "✅ Config Saved", Desc = CONFIG_FILE, Duration = 3}) end
    else
        warn("[Config] Save failed:", err)
        if WindUI then WindUI:Notify({Title = "❌ Save Failed", Desc = tostring(err), Duration = 3}) end
    end
end

local function LoadConfig()
    local ok, content = pcall(function() return readfile(CONFIG_FILE) end)
    if not ok or not content then
        if WindUI then WindUI:Notify({Title = "⚠️ No Config Found", Duration = 3}) end
        return
    end
    local decodeOk, data = pcall(function() return HttpService:JSONDecode(content) end)
    if not decodeOk or not data then
        if WindUI then WindUI:Notify({Title = "❌ Load Failed", Desc = "Invalid JSON", Duration = 3}) end
        return
    end
    ApplyValues(data)
    if WindUI then WindUI:Notify({Title = "✅ Config Loaded", Duration = 3}) end
end

local function DeleteConfig()
    local ok, err = pcall(function() delfile(CONFIG_FILE) end)
    if ok then
        if WindUI then WindUI:Notify({Title = "✅ Config Deleted", Duration = 3}) end
    else
        warn("[Config] Delete failed:", err)
    end
end

