local FistsModifier = false

local function modifyFists(tool, enable)
    if tool then
        local attrs = tool:GetAttributes()
        local keys = {}
        for k, _ in pairs(attrs) do table.insert(keys, k) end
        table.sort(keys)
        if #keys >= 7 then
            local key1 = keys[6]
            local key2 = keys[7]
            if enable then
                if State.OriginalFistsAttributes[key1] == nil then State.OriginalFistsAttributes[key1] = tool:GetAttribute(key1) end
                if State.OriginalFistsAttributes[key2] == nil then State.OriginalFistsAttributes[key2] = tool:GetAttribute(key2) end
                tool:SetAttribute(key1, 360)
                tool:SetAttribute(key2, 20)
            else
                if State.OriginalFistsAttributes[key1] then tool:SetAttribute(key1, State.OriginalFistsAttributes[key1]) end
                if State.OriginalFistsAttributes[key2] then tool:SetAttribute(key2, State.OriginalFistsAttributes[key2]) end
            end
        end
    end
end

local meleeList = {}
if MeleeFolder then
    for _, tool in ipairs(MeleeFolder:GetChildren()) do table.insert(meleeList, tool.Name) end
end

local function isMeleeToolCheck(tool)
    if not tool:IsA("Tool") then return false end
    if tool.Name == "Fists" then return true end
    for _, name in ipairs(meleeList) do
        if tool.Name == name then return true end
    end
    return false
end

local function checkAndModifyFists()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not char or not backpack then return end
    local tools = {}
    for _, tool in ipairs(char:GetChildren()) do
        if isMeleeToolCheck(tool) then table.insert(tools, tool) end
    end
    for _, tool in ipairs(backpack:GetChildren()) do
        if isMeleeToolCheck(tool) then table.insert(tools, tool) end
    end
    for _, tool in ipairs(tools) do modifyFists(tool, FistsModifier) end
end

