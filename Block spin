local function updateTracer(target)
    if not target or not target.Character then
        hideTracer()
        return
    end
    local char = target.Character
    local hum = char:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then
        hideTracer()
        return
    end
    local aimPart = Config.SelectedAimPart or "Head"
    local targetPart
    if aimPart == "Random" then
        if State.RandomAimPart == "Torso" then
            targetPart = char:FindFirstChild("HumanoidRootPart")
        else
            targetPart = char:FindFirstChild("Head")
        end
    elseif aimPart == "HumanoidRootPart" then
        targetPart = char:FindFirstChild("HumanoidRootPart")
    else
        targetPart = char:FindFirstChild("Head")
    end
    if not targetPart then
        hideTracer()
        return
    end
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local targetPos = targetPart.Position
    State.AimPartTarget = State.AimPartTarget:Lerp(targetPos, State.VelocitySmoothFactor)
    local smoothTarget = State.AimPartTarget
    local screenPos, onScreen = Camera:WorldToViewportPoint(smoothTarget)
    if not onScreen then
        hideTracer()
        return
    end
    local tracer = getOrCreateTracer()
    tracer.Visible = true
    tracer.From = screenCenter
    tracer.To = Vector2.new(screenPos.X, screenPos.Y)
    local box = createTracerBox()
    local topScreen = Camera:WorldToViewportPoint(targetPart.Position + Vector3.new(0, 0.5, 0))
    local bottomScreen = Camera:WorldToViewportPoint(targetPart.Position - Vector3.new(0, 0.5, 0))
    local center = Vector2.new(screenPos.X, screenPos.Y)
    local halfHeight = (topScreen - bottomScreen).Magnitude / 2
    local halfWidth = halfHeight
    local minSize, maxSize = 8, 25
    halfWidth = math.clamp(halfWidth, minSize, maxSize)
    halfHeight = math.clamp(halfHeight, minSize, maxSize)
    local top = Vector2.new(center.X, center.Y - halfHeight)
    local bottom = Vector2.new(center.X, center.Y + halfHeight)
    local left = Vector2.new(center.X - halfWidth, center.Y)
    local right = Vector2.new(center.X + halfWidth, center.Y)
    box[1].From, box[1].To = top, right
    box[2].From, box[2].To = right, bottom
    box[3].From, box[3].To = bottom, left
    box[4].From, box[4].To = left, top
    for i = 1, 4 do box[i].Visible = true end
end

