local function modifyFists(tool, enable)
    if tool then
        local attrs = tool:GetAttributes()
        local keys = {}
        for k, _ in pairs(attrs) do table.insert(keys, k) end
        table.sort(keys)
        if #keys >= 7 then
            local key1 = keys[6]
            local key2 = keys[7]
            if enable then
                if OriginalFistsAttributes[key1] == nil then OriginalFistsAttributes[key1] = tool:GetAttribute(key1) end
                if OriginalFistsAttributes[key2] == nil then OriginalFistsAttributes[key2] = tool:GetAttribute(key2) end
                tool:SetAttribute(key1, 360)
                tool:SetAttribute(key2, 20)
            else
                if OriginalFistsAttributes[key1] then tool:SetAttribute(key1, OriginalFistsAttributes[key1]) end
                if OriginalFistsAttributes[key2] then tool:SetAttribute(key2, OriginalFistsAttributes[key2]) end
            end
        end
    end
end

