            end
        end
        print("âœ“ Invisibilidad activada")
    end
end

local function DisableInvisibility()
    if LocalPlayer.Character then
        for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                if part.Name == "Head" or part.Name == "Torso" or part.Name:match("Arm") or part.Name:match("Leg") then
                    part.Transparency = 0
                else
                    part.Transparency = 0
                end
            end
        end
        print("âœ— Invisibilidad desactivada")
    end
end

