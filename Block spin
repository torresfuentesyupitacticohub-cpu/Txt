-- ==================== SILENT AIM HOOK ====================
if SendRemote and SendRemote.FireServer then
    local originalFireServer
    pcall(function()
        originalFireServer = hookfunction(SendRemote.FireServer, function(self, ...)
            if self ~= SendRemote then return originalFireServer(self, ...) end
            local args = {...}
            if Config.SilentAim and args[2] == "shoot_gun" and State.CurrentTarget then
                local char = State.CurrentTarget.Character
                local head = char and char:FindFirstChild("Head")
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChild("Humanoid")
                if head and hrp and hum then
                    local targetPart, targetInstance
                    if Config.SelectedAimPart == "Random" then
                        local choice = pickRandomAimPart()
                        if choice == "Torso" then
                            targetPart = hrp
                            targetInstance = hrp
                        else
                            targetPart = head
                            targetInstance = head
                        end
                    elseif Config.SelectedAimPart == "HumanoidRootPart" then
                        targetPart = hrp
                        targetInstance = hrp
                    else
                        targetPart = head
                        targetInstance = head
                    end
                    local predictedPos = predictPositionForPlayer(targetPart, hrp)
                    local myHead = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head")
                    local myPos = myHead and myHead.Position or nil
                    if isShotgun() then
                        args[4] = CFrame.new(myPos, predictedPos)
                        local hits = {}
                        for i = 1, 8 do
                            local spread = Vector3.new(math.random(-2, 2) * 0.03, math.random(-2, 2) * 0.03, math.random(-2, 2) * 0.03)
                            table.insert(hits, {[1] = {Instance = targetInstance, Normal = Vector3.new(0, 1, 0), Position = predictedPos + spread}})
                        end
                        args[5] = hits
                    else
                        local behindWall = isBehindWall(myPos, predictedPos)
                        if behindWall then
                            args[4] = CFrame.new(math.huge, math.huge, math.huge)
                        else
                            args[4] = CFrame.new(myPos, predictedPos)
                        end
                        args[5] = {[1] = {[1] = {Instance = targetInstance, Normal = Vector3.new(0, 1, 0), Position = predictedPos}}}
                    end
                end
            end
            return originalFireServer(self, unpack(args))
        end)
    end)
end

