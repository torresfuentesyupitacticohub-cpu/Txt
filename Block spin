-- ESP Implementation using Highlights (Roblox Native) and Billboards
local ESPObjects = {}

function RefreshESP()
    -- Clear existing
    for _, obj in pairs(ESPObjects) do
        if obj.Highlight then obj.Highlight:Destroy() end
        if obj.Billboard then obj.Billboard:Destroy() end
    end
    ESPObjects = {}

    if not _G.ESPEnabled then return end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            CreateESP(player)
        end
    end
end

function CreateESP(player)
    if ESPObjects[player] then return end
    
    local container = Instance.new("Folder")
    container.Name = "ESP_" .. player.Name
    container.Parent = Workspace

    -- Highlight
    local highlight = Instance.new("Highlight")
    highlight.Adornee = player.Character
    highlight.FillTransparency = 0.7
    highlight.OutlineTransparency = 0
    highlight.OutlineColor = Color3.fromRGB(0,0,0)
    highlight.FillColor = _G.ESPColor or Color3.new(1,1,1)
    highlight.Enabled = _G.ESPEnabled
    highlight.Parent = container

    -- Billboard for Name/Health
    local billboard = Instance.new("BillboardGui")
    billboard.AlwaysOnTop = true
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.Parent = container
    
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 0.5, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.TextStrokeTransparency = 0.5
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextSize = 18
    nameLabel.Parent = billboard
    
    local healthBarBg = Instance.new("Frame")
    healthBarBg.Size = UDim2.new(1, 0, 0.2, 0)
    healthBarBg.Position = UDim2.new(0, 0, 0.5, 0)
    healthBarBg.BackgroundColor3 = Color3.new(0,0,0)
    healthBarBg.Parent = billboard
    
    local healthBarFill = Instance.new("Frame")
    healthBarFill.Size = UDim2.new(1, 0, 1, 0)
    healthBarFill.BackgroundColor3 = Color3.new(0,1,0)
    healthBarFill.Parent = healthBarBg

    ESPObjects[player] = {
        Highlight = highlight,
        Billboard = billboard,
        NameLabel = nameLabel,
        HealthBar = healthBarFill,
        Container = container
    }
    
    -- Connect to character changes
    player.CharacterAdded:Connect(function(char)
        if ESPObjects[player] then
            ESPObjects[player].Highlight.Adornee = char
            billboard.Adornee = char:FindFirstChild("Head")
        end
    end)
end

Players.PlayerAdded:Connect(CreateESP)
Players.PlayerRemoving:Connect(function(player)
    if ESPObjects[player] then
        ESPObjects[player].Container:Destroy()
        ESPObjects[player] = nil
    end
end)

-- ESP Update Loop
RunService.RenderStepped:Connect(function()
    if not _G.ESPEnabled then return end
    
    for player, objects in pairs(ESPObjects) do
        if player.Character and objects.Highlight then
            local enabled = _G.ESPEnabled
            objects.Highlight.Enabled = enabled
            objects.Highlight.FillColor = _G.ESPColor or Color3.new(1,1,1)
            
            if objects.Billboard then
                objects.Billboard.Enabled = enabled
                
                if objects.NameLabel then
                    local text = player.Name
                    if _G.ESPDistance then
                        local dist = (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("HumanoidRootPart")) 
                            and math.floor((LocalPlayer.Character.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude) 
                            or 0
                        text = text .. " [" .. dist .. "m]"
                    end
                    objects.NameLabel.Text = _G.ESPNames and text or ""
                    objects.NameLabel.TextColor3 = _G.ESPColor or Color3.new(1,1,1)
                end
                
                if objects.HealthBar and _G.ESPHealth then
                    local hum = player.Character:FindFirstChild("Humanoid")
                    if hum then
                        objects.HealthBar.Visible = true
                        objects.HealthBar.Size = UDim2.new(hum.Health / hum.MaxHealth, 0, 1, 0)
                        objects.HealthBar.BackgroundColor3 = Color3.fromHSV((hum.Health / hum.MaxHealth) * 0.3, 1, 1)
                    else
                        objects.HealthBar.Visible = false
                    end
                elseif objects.HealthBar then
                    objects.HealthBar.Visible = false
                end
            end
        end
    end
end)


