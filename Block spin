-- Хук FireServer для Silent Aim
local originalFireServer
if SendRemote and SendRemote.FireServer then
    local success = pcall(function()
        originalFireServer = hookfunction(SendRemote.FireServer, function(self, ...)
            if self ~= SendRemote then return originalFireServer(self, ...) end
            local args = {...}
            if Config.SilentAim and args[2] == "shoot_gun" and CurrentTarget then
                local head = CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("Head")
                local hrp = CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("HumanoidRootPart")
                local hum = CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("Humanoid")
                if head and hrp and hum then
                    local targetPart = head
                    if Config.SelectedAimPart == "HumanoidRootPart" then
                        targetPart = hrp
                    elseif Config.SelectedAimPart == "Random" then
                        targetPart = math.random(1, 2) == 1 and head or hrp
                    end
                    local predictedPos = predictPositionForPlayer(targetPart, hrp)
                    local myHead = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head")
                    local myPos = myHead and myHead.Position or nil
                    if isShotgun() then
                        args[4] = CFrame.new(myPos, predictedPos)
                        local hits = {}
                        for i = 1, 8 do
                            local spread = Vector3.new(math.random(-2, 2) * 0.03, math.random(-2, 2) * 0.03, math.random(-2, 2) * 0.03)
                            table.insert(hits, {[1] = {Instance = head, Normal = Vector3.new(0, 1, 0), Position = predictedPos + spread}})
                        end
                        args[5] = hits
                    else
                        local behindWall = isBehindWall(myPos, predictedPos)
                        if behindWall then
                            args[4] = CFrame.new(math.huge, math.huge, math.huge)
                        else
                            args[4] = CFrame.new(myPos, predictedPos)
                        end
                        args[5] = {[1] = {[1] = {Instance = head, Normal = Vector3.new(0, 1, 0), Position = predictedPos}}}
                    end
                    -- Визуальный tracer
                    local tracerPart = Instance.new("Part")
                    tracerPart.Anchored = true
                    tracerPart.CanCollide = false
                    tracerPart.Size = Vector3.new(0.08, 0.08, (predictedPos - myPos).Magnitude)
                    tracerPart.CFrame = CFrame.new(myPos, predictedPos) * CFrame.new(0, 0, -tracerPart.Size.Z / 2)
                    tracerPart.Material = Enum.Material.Neon
                    tracerPart.Transparency = 0.35
                    tracerPart.Color = Color3.fromRGB(255, 0, 0)
                    tracerPart.Parent = workspace
                    Debris:AddItem(tracerPart, 4)
                    -- Эффект попадания
                    local healthBefore = hum.Health
                    spawn(function()
                        wait(0.1)
                        if hum and hum.Health < healthBefore then
                            tracerPart.Color = Color3.fromRGB(0, 255, 0)
                            for _, part in ipairs(CurrentTarget.Character:GetDescendants()) do
                                if part:IsA("BasePart") then
                                    local effect = Instance.new("Part")
                                    effect.Size = part.Size + Vector3.new(0.05, 0.05, 0.05)
                                    effect.CFrame = part.CFrame
                                    effect.Anchored = true
                                    effect.CanCollide = false
                                    effect.Material = Enum.Material.Neon
                                    effect.Color = Color3.fromRGB(255, 0, 0)
                                    effect.Transparency = 0.5
                                    effect.Parent = workspace
                                    TweenService:Create(effect, TweenInfo.new(1.5, Enum.EasingStyle.Linear), {Transparency = 1}):Play()
                                    Debris:AddItem(effect, 2)
                                end
                            end
                            if head then
                                local ball = Instance.new("Part")
                                ball.Size = Vector3.new(0.2, 0.2, 0.2)
                                ball.Shape = Enum.PartType.Ball
                                ball.Material = Enum.Material.Neon
                                ball.Color = Color3.fromRGB(255, 0, 0)
                                ball.CFrame = CFrame.new(head.Position)
                                ball.Anchored = false
                                ball.CanCollide = false
                                ball.Parent = workspace
                                local bv = Instance.new("BodyVelocity")
                                bv.Velocity = Vector3.new(math.random(-5, 5), math.random(5, 10), math.random(-5, 5))
                                bv.P = 5000
                                bv.MaxForce = Vector3.new(4000, 4000, 4000)
                                bv.Parent = ball
                                Debris:AddItem(ball, 1)
                            end
                        else
                            tracerPart.Color = Color3.fromRGB(255, 0, 0)
                        end
                    end)
                end
            end
            return originalFireServer(self, unpack(args))
        end)
    end)
end

