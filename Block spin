local function calculateVelocity(player)
    local history = State.VelocityHistory[player]
    if not history or #history < 2 then return Vector3.new() end
    local totalVel = Vector3.new()
    local count = 0
    for i = 2, #history do
        local dt = history[i].time - history[i - 1].time
        if dt > 0 then
            totalVel = totalVel + (history[i].pos - history[i - 1].pos) / dt
            count = count + 1
        end
    end
    if count == 0 then return Vector3.new() end
    local avgVel = totalVel / count
    if totalVel.Magnitude < 10 then return totalVel end
    if avgVel.Y > State.MaxVerticalSpeed then
        return Vector3.new(avgVel.X * 1.11, math.clamp(avgVel.Y * 0.97, 0, 360), avgVel.Z * 1.11)
    end
    return avgVel
end

local function predictPositionForPlayer(part, hrp)
    if not part then return Vector3.zero end
    local parent = part.Parent
    local player = parent and Players:GetPlayerFromCharacter(parent)
    if not player then return part.Position end
    local velocity = calculateVelocity(player) or Vector3.zero
    local ping = getPing()
    if ping < 0 then ping = 0.1 end
    return part.Position + (velocity * ping * State.VelocitySmoothing)
end

