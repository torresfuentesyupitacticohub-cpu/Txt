local function useHealTool(tool)
    local char = LocalPlayer.Character
    if not char then return end
    local oldTool = char:FindFirstChildWhichIsA("Tool")
    tool.Parent = char
    task.wait(0.01)
    if tool:FindFirstChild("RemoteEvent") then
        tool.RemoteEvent:FireServer()
    elseif tool:FindFirstChild("Use") then
        tool:Use()
    else
        tool:Activate()
    end
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    local anim = hum and hum:FindFirstChildWhichIsA("Animator")
    if anim then
        for _, track in pairs(anim:GetPlayingAnimationTracks()) do
            track:Stop(0)
        end
    end
    task.wait(0.2)
    if oldTool and oldTool.Parent == char then
        oldTool.Parent = LocalPlayer.Backpack
    end
end

