                    FOVCircle.Radius = FOV
                end
            end
        end
        if closest and closest.Character then
            local char = closest.Character
            local hum = char:FindFirstChild("Humanoid")
            local aimPart = Config.SelectedAimPart or "Head"
            local targetPart
            if aimPart == "Random" then
                targetPart = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
            elseif aimPart == "HumanoidRootPart" then
                targetPart = char:FindFirstChild("HumanoidRootPart")
            else
                targetPart = char:FindFirstChild("Head")
            end
            if hum and hum.Health > 0 and targetPart then
                local screenCenter = Vector2.new(workspace.CurrentCamera.ViewportSize.X / 2, workspace.CurrentCamera.ViewportSize.Y / 2)
                local targetPos = targetPart.Position
                aimPartTarget = aimPartTarget:Lerp(targetPos, velocitySmoothFactor)
                local smoothTarget = aimPartTarget
                local screenPos, onScreen = workspace.CurrentCamera:WorldToViewportPoint(smoothTarget)
                if onScreen then
                    TracerLine.Visible = true
                    TracerLine.From = screenCenter
                    TracerLine.To = Vector2.new(screenPos.X, screenPos.Y)
                    TracerLine.Color = Color3.fromRGB(255, 50, 50)
                    TracerLine.Thickness = 1.3
                    if not TracerESP then
                        TracerESP = {}
                        for i = 1, 4 do
                            TracerESP[i] = Drawing.new("Line")
                            TracerESP[i].Color = Color3.fromRGB(255, 255, 255)
                            TracerESP[i].Thickness = 1.2
                            TracerESP[i].Visible = true
                        end
                    end
                    local topScreen = workspace.CurrentCamera:WorldToViewportPoint(targetPart.Position + Vector3.new(0, 0.5, 0))
                    local bottomScreen = workspace.CurrentCamera:WorldToViewportPoint(targetPart.Position - Vector3.new(0, 0.5, 0))
                    local center = Vector2.new(screenPos.X, screenPos.Y)
                    local halfHeight = (topScreen - bottomScreen).Magnitude / 2
                    local halfWidth = halfHeight
                    local minSize = 8
                    local maxSize = 25
                    halfWidth = math.clamp(halfWidth, minSize, maxSize)
                    halfHeight = math.clamp(halfHeight, minSize, maxSize)
                    local top = Vector2.new(center.X, center.Y - halfHeight)
                    local bottom = Vector2.new(center.X, center.Y + halfHeight)
                    local left = Vector2.new(center.X - halfWidth, center.Y)
                    local right = Vector2.new(center.X + halfWidth, center.Y)
                    TracerESP[1].From, TracerESP[1].To = top, right
                    TracerESP[2].From, TracerESP[2].To = right, bottom
                    TracerESP[3].From, TracerESP[3].To = bottom, left
                    TracerESP[4].From, TracerESP[4].To = left, top
                    for i = 1, 4 do TracerESP[i].Visible = true end
                else
                    TracerLine.Visible = false
                    if TracerESP then for i = 1, 4 do TracerESP[i].Visible = false end end
                end
            else
                TracerLine.Visible = false
                if TracerESP then for i = 1, 4 do TracerESP[i].Visible = false end end
            end
        else
            TracerLine.Visible = false
            if TracerESP then for i = 1, 4 do TracerESP[i].Visible = false end end
            aimPartTarget = Vector3.new()
        end
        if JumpPowerEnabled and FlyEnabled and RootPart then
            local vel = RootPart.Velocity
            RootPart.Velocity = Vector3.new(vel.X, FlySpeed, vel.Z)
        end
        if SnapActive and SnapY and RootPart then
