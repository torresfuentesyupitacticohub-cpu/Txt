-- =============================================
-- ✅ AUTO PESCA - Detecta el minijuego de pesca y completa
-- =============================================
do
    local ReplicatedStorage3 = game:GetService("ReplicatedStorage")
    local VirtualInputManager2 = game:GetService("VirtualInputManager")
    local RunService3 = game:GetService("RunService")
    
    local fishAutoEnabled = false
    local fishRenderConn = nil
    local fishLastClick = 0
    local FishingMinigame = nil
    
    -- Intentar cargar el módulo de pesca
    pcall(function()
        FishingMinigame = require(ReplicatedStorage3.Modules.Game.Minigames.FishingMinigame)
    end)
    -- También intentar otras rutas comunes
    if not FishingMinigame then
        pcall(function()
            FishingMinigame = require(ReplicatedStorage3.Modules.Game.Fishing.Minigame)
        end)
    end
    if not FishingMinigame then
        pcall(function()
            FishingMinigame = require(ReplicatedStorage3.Modules.Game.Fish.Minigame)
        end)
    end
    
    local function autoFish()
        pcall(function()
            if not FishingMinigame then return end
            
            -- Verificar si el minijuego está activo
            local isActive = false
            pcall(function()
                if FishingMinigame.enabled and FishingMinigame.enabled.get then
                    isActive = FishingMinigame.enabled.get()
                elseif FishingMinigame.is_active and FishingMinigame.is_active.get then
                    isActive = FishingMinigame.is_active.get()
                elseif FishingMinigame.active and FishingMinigame.active.get then
                    isActive = FishingMinigame.active.get()
                end
            end)
            if not isActive then return end
            
            -- Obtener posiciones de la aguja y el objetivo
            local needle, target, size
            pcall(function()
                needle = FishingMinigame.needle_pos and FishingMinigame.needle_pos.get() or 0
                target = FishingMinigame.target_pos and FishingMinigame.target_pos.get() or 0.5
                size = FishingMinigame.target_size and FishingMinigame.target_size.get() or 0.1
            end)
            
            if type(needle) ~= "number" then needle = 0 end
            if type(target) ~= "number" then target = 0.5 end
            if type(size) ~= "number" then size = 0.1 end
            
            local tolerance = (size > 0) and (size / 2) * 0.8 or 0.05
            
            if math.abs(needle - target) <= tolerance and tick() - fishLastClick > 0.3 then
                fishLastClick = tick()
                local cam = workspace.CurrentCamera
                local x, y = cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2
                VirtualInputManager2:SendMouseButtonEvent(x, y, 0, true, game, 0)
                task.wait(0.03)
                VirtualInputManager2:SendMouseButtonEvent(x, y, 0, false, game, 0)
            end
        end)
    end
    
    local fishToggle = bk:Toggle({
        Title = "🎣 Auto Pesca",
        Desc = "Completa el minijuego de pesca automático",
        Default = false,
        Callback = function(bx)
            fishAutoEnabled = bx
            if fishRenderConn then
                pcall(function() fishRenderConn:Disconnect() end)
                fishRenderConn = nil
            end
            if bx then
                fishRenderConn = RunService3.RenderStepped:Connect(function()
                    if fishAutoEnabled then autoFish() end
                end)
                if A then A:Notify({Title = "✅ Auto Pesca ON", Description = "Pescando automáticamente", Duration = 3}) end
            else
                if A then A:Notify({Title = "❌ Auto Pesca OFF", Duration = 3}) end
            end
        end
    })
    D:Register("AutoPesca", fishToggle)
end

