    Desc = "Repela carros enemigos cercanos (FIXED)",
    Default = false,
    Callback = function(bx)
        BumpAuraCarEnabled = bx
        if bumpAuraLoop then
            pcall(function() task.cancel(bumpAuraLoop) end)
            bumpAuraLoop = nil
        end
        if bx then
            bumpAuraLoop = task.spawn(function()
                while BumpAuraCarEnabled do
                    task.wait(0.1)
                    pcall(function()
                        local client = game.Players.LocalPlayer
                        local char = client.Character
                        if not char then return end
                        local hrp = char:FindFirstChild("HumanoidRootPart")
                        if not hrp then return end
                        
                        local vehicles = workspace:FindFirstChild("Vehicles")
                        if not vehicles then return end
                        
                        for _, vehicle in ipairs(vehicles:GetChildren()) do
                            if vehicle:IsA("Model") then
                                local ownerId = vehicle:GetAttribute("OwnerUserId")
                                -- Solo afectar carros que NO son tuyos
                                if ownerId ~= client.UserId then
                                    -- ✅ FIX: Reclamar network ownership del vehículo enemigo
                                    pcall(function() vehicle:SetNetworkOwner(client) end)
                                    
                                    local vPart = vehicle.PrimaryPart or vehicle:FindFirstChildWhichIsA("BasePart")
                                    if vPart then
                                        local dist = (vPart.Position - hrp.Position).Magnitude
                                        if dist < 35 then
                                            -- ✅ Aplicar fuerza con BodyVelocity (más fiable que AssemblyLinearVelocity)
                                            local pushDir = (vPart.Position - hrp.Position).Unit
                                            if pushDir.Magnitude > 0 then
                                                -- Eliminar BodyVelocity anterior si existe
                                                local oldBV = vPart:FindFirstChild("BumpAuraBV")
                                                if oldBV then oldBV:Destroy() end
                                                
                                                local bv = Instance.new("BodyVelocity")
                                                bv.Name = "BumpAuraBV"
                                                bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
                                                bv.Velocity = pushDir * 250 + Vector3.new(0, 80, 0)
                                                bv.Parent = vPart
                                                
                                                -- Aplicar spin
                                                local oldBG = vPart:FindFirstChild("BumpAuraBG")
                                                if oldBG then oldBG:Destroy() end
                                                
                                                local bg = Instance.new("BodyAngularVelocity")
                                                bg.Name = "BumpAuraBG"
                                                bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
                                                bg.AngularVelocity = Vector3.new(math.random(-30,30), math.random(-30,30), math.random(-30,30))
                                                bg.Parent = vPart
                                                
                                                -- Limpiar después de 0.3s
                                                task.delay(0.3, function()
                                                    pcall(function() bv:Destroy() end)
                                                    pcall(function() bg:Destroy() end)
                                                end)
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end)
                end
            end)
            if A then A:Notify({Title = "✅ Bump Aura Car ON", Description = "Repeliendo carros enemigos", Duration = 3}) end
        else
            if A then A:Notify({Title = "❌ Bump Aura Car OFF", Duration = 3}) end
        end
    end
})

