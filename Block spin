    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

Mouse.Move:Connect(function()
    if dragging then
        local delta = Mouse.Position - dragStart
        MainFrame.Position = startPos + UDim2.new(0, delta.X, 0, delta.Y)
    end
end)
