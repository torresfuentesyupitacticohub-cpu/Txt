-- Трекинг скорости
local velocityHistory = {}
local maxHistory = 6
local velocitySmoothing = 0.80
local maxVerticalSpeed = 150
local velocitySmoothFactor = 1
local aimPartTarget = Vector3.new()

RunService.Heartbeat:Connect(function()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChild("Humanoid")
            if hrp and hum and hum.Health > 0 then
                velocityHistory[player] = velocityHistory[player] or {}
                table.insert(velocityHistory[player], {time = os.clock(), pos = hrp.Position})
                if #velocityHistory[player] > maxHistory then table.remove(velocityHistory[player], 1) end
            else
                velocityHistory[player] = nil
            end
        end
    end
end)

Players.PlayerRemoving:Connect(function(player) velocityHistory[player] = nil end)

-- Расчёт скорости
local function calculateVelocity(player)
    local history = velocityHistory[player]
    if not history or #history < 2 then return Vector3.new() end
    local totalVel = Vector3.new()
    local count = 0
    for i = 2, #history do
        local dt = history[i].time - history[i - 1].time
        if dt > 0 then
            totalVel = totalVel + (history[i].pos - history[i - 1].pos) / dt
            count = count + 1
        end
    end
    if count == 0 then return Vector3.new() end
    local avgVel = totalVel / count
    if totalVel.Magnitude < 10 then return totalVel end
    if avgVel.Y > maxVerticalSpeed then
        return Vector3.new(avgVel.X * 1.11, math.clamp(avgVel.Y * 0.97, 0, 360), avgVel.Z * 1.11)
    end
    return avgVel
end

-- Предсказание позиции для игрока
local function predictPositionForPlayer(part, hrp)
    if not part then return Vector3.zero end
    local parent = part.Parent
    local player = parent and Players:GetPlayerFromCharacter(parent)
    if not player then return part.Position end
    local velocity = calculateVelocity(player) or Vector3.zero
    local ping = (getPing and getPing()) or 0.1
    if ping < 0 then ping = 0.1 end
    return part.Position + (velocity * ping * velocitySmoothing)
end

