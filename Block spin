-- Auto Pick Loop
task.spawn(function()
    local dropfolder = Workspace:WaitForChild('DroppedItems')
    local itemsFolder = ReplicatedStorage:FindFirstChild('Items')
    
    -- Cache rarities
    local itemRarityCache = {}
    if itemsFolder then
        for _, template in ipairs(itemsFolder:GetDescendants()) do
            if not template:IsA('ModuleScript') and not template:IsA('Folder') then
                local rarity = template:GetAttribute('RarityName')
                if rarity then itemRarityCache[template.Name] = rarity end
            end
        end
    end

    while task.wait(0.1) do
        if _G.AutoPickItems and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild('HumanoidRootPart') then
            for _, v in ipairs(dropfolder:GetChildren()) do
                if v and not v:GetAttribute('Locked') then
                    -- Check blacklist
                    local dropName = v:GetAttribute('ItemName') or v.Name
                    local rarity = itemRarityCache[dropName]
                    local blacklisted = false
                    if rarity then
                        for _, r in ipairs(_G.BlacklistRarity or {}) do
                            if r == rarity then blacklisted = true break end
                        end
                    end
                    
                    if not blacklisted then
                        local zone = v:FindFirstChild('PickUpZone')
                        if zone then
                             if zone.Size ~= Vector3.new(22, 22, 22) then
                                zone.Size = Vector3.new(22, 22, 22)
                                zone.CanCollide = false
                            end
                            local dist = (RootPart.Position - zone.Position).Magnitude
                            if dist < 50 then -- Pickup range
                                Net.get('pickup_dropped_item', v)
                                task.wait(0.02)
                            end
                        end
                    end
                end
            end
        end
    end
end)


