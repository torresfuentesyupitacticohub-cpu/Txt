local function ATMMoney()
    local bankBalance = 0
    pcall(function()
        for _, v in ipairs(PlayerGui:GetDescendants()) do
            if v:IsA('TextLabel') and string.find(v.Text, 'Bank Balance') then
                local amount = tonumber(v.Text:match('%$(%d+)'))
                if amount then
                    bankBalance = amount
                    break
                end
            end
        end
    end)
    return bankBalance
end

