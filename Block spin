-- ✅ SAVE CAR (FIXED) - Trae tu carro si se aleja
-- Issue anterior: SetPrimaryPartCFrame falla si no tienes network ownership
-- =============================================
local SaveCarEnabled = false
local saveCarLoop = nil

VehicleTab:Toggle({
    Title = "💾 Save Car",
    Desc = "Trae tu carro si se aleja (FIXED)",
    Default = false,
    Callback = function(bx)
        SaveCarEnabled = bx
        if saveCarLoop then
            pcall(function() task.cancel(saveCarLoop) end)
            saveCarLoop = nil
        end
        if bx then
            saveCarLoop = task.spawn(function()
                while SaveCarEnabled do
                    task.wait(1)
                    pcall(function()
                        local client = game.Players.LocalPlayer
                        local char = client.Character
                        if not char then return end
                        local hrp = char:FindFirstChild("HumanoidRootPart")
                        if not hrp then return end
                        
                        local vehicle = getMyVehicle()
                        if not vehicle then return end
                        
                        local vPart = vehicle.PrimaryPart or vehicle:FindFirstChildWhichIsA("BasePart")
                        if not vPart then return end
                        
                        local dist = (vPart.Position - hrp.Position).Magnitude
                        -- Si el carro está a más de 50 studs, lo traemos
                        if dist > 50 then
                            -- ✅ FIX: Reclamar ownership (getMyVehicle ya lo hace)
                            local offset = CFrame.new(math.random(-4, 4), 3, math.random(-10, -5))
                            -- ✅ FIX: Usar CFrame.new directo en vPart (más fiable que SetPrimaryPartCFrame)
                            pcall(function()
                                vPart.CFrame = hrp.CFrame * offset
                                -- Si el carro tiene PrimaryPart, también forzar
                                if vehicle.PrimaryPart and vehicle.PrimaryPart ~= vPart then
                                    vehicle:SetPrimaryPartCFrame(hrp.CFrame * offset)
                                end
                            end)
                        end
                    end)
                end
            end)
            if A then A:Notify({Title = "✅ Save Car ON", Description = "Traerá tu carro si se aleja >50 studs", Duration = 3}) end
        else
            if A then A:Notify({Title = "❌ Save Car OFF", Duration = 3}) end
        end
    end
})

-- =============================================
-- ✅ MODS CAR - Speed Car slider (1-100)
-- Cuando mueves, el carro se mueve a esa velocidad
-- =============================================
VehicleTab:Divider()
VehicleTab:Section({Title = "Car Mods / Speed Car"})

local SpeedCarValue = 50
local SpeedCarEnabled = false
local speedCarLoop = nil

VehicleTab:Slider({
    Title = "Speed Car (1-100)",
    Step = 1,
    Value = {Min = 1, Max = 100, Default = 50},
    Callback = function(bx)
        SpeedCarValue = tonumber(bx) or 50
    end
})

VehicleTab:Toggle({
    Title = "🚀 Speed Car",
    Desc = "Mueve el carro en todas direcciones con velocidad ajustable",
    Default = false,
    Callback = function(bx)
        SpeedCarEnabled = bx
        if speedCarLoop then
            pcall(function() task.cancel(speedCarLoop) end)
            speedCarLoop = nil
        end
        if bx then
            speedCarLoop = task.spawn(function()
                local Players = game:GetService("Players")
                local RunService = game:GetService("RunService")
                local UserInputService = game:GetService("UserInputService")
                local client = Players.LocalPlayer
                
                -- ✅ Loop principal: aplica velocidad según teclas WASD
                while SpeedCarEnabled do
                    task.wait()
                    pcall(function()
                        local vehicle = getMyVehicle()
                        if not vehicle then return end
                        local vPart = vehicle.PrimaryPart or vehicle:FindFirstChildWhichIsA("BasePart")
                        if not vPart then return end
                        
                        -- Calcular vector de movimiento según teclas
                        local forward = 0
                        local side = 0
                        local up = 0
                        
                        -- ✅ WASD + Flechas para mover en todas direcciones
                        if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up) then
                            forward = 1
                        elseif UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down) then
                            forward = -1
                        end
                        
                        if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then
                            side = -1
                        elseif UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then
                            side = 1
                        end
                        
                        -- Espacio para subir, Shift para bajar
                        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                            up = 1
                        elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift) then
                            up = -1
                        end
                        
                        -- Si hay alguna tecla de movimiento presionada
                        if forward ~= 0 or side ~= 0 or up ~= 0 then
                            -- ✅ Multiplicar la velocidad por el valor del slider (1-100)
                            local speedMultiplier = SpeedCarValue * 3  -- 1=3 speed, 100=300 speed
                            
                            -- Calcular dirección en el espacio del carro
                            local lookDir = vPart.CFrame.LookVector
                            local rightDir = vPart.CFrame.RightVector
                            
                            local moveVector = (lookDir * forward + rightDir * side + Vector3.new(0, up, 0))
                            if moveVector.Magnitude > 0 then
                                moveVector = moveVector.Unit * speedMultiplier
                            end
                            
                            -- ✅ Aplicar BodyVelocity para mover el carro
                            local oldBV = vPart:FindFirstChild("SpeedCarBV")
                            if oldBV then oldBV:Destroy() end
                            
                            local bv = Instance.new("BodyVelocity")
                            bv.Name = "SpeedCarBV"
                            bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
                            bv.Velocity = moveVector
                            bv.Parent = vPart
                        else
                            -- Si no hay teclas, detener BodyVelocity
                            local oldBV = vPart:FindFirstChild("SpeedCarBV")
                            if oldBV then
                                oldBV.Velocity = Vector3.new(0, 0, 0)
                                -- Quitar después de 0.1s para no acumular
                                task.delay(0.1, function()
                                    pcall(function() oldBV:Destroy() end)
                                end)
                            end
                        end
                    end)
                end
                
                -- Cleanup al desactivar
                pcall(function()
                    local vehicle = getMyVehicle()
                    if vehicle then
                        local vPart = vehicle.PrimaryPart or vehicle:FindFirstChildWhichIsA("BasePart")
                        if vPart then
                            local oldBV = vPart:FindFirstChild("SpeedCarBV")
                            if oldBV then oldBV:Destroy() end
                        end
                    end
                end)
            end)
            if A then A:Notify({
                Title = "✅ Speed Car ON",
                Description = "Usa WASD/Flechas para mover - Espacio=Subir, Shift=Bajar",
                Duration = 5
            }) end
        else
            if A then A:Notify({Title = "❌ Speed Car OFF", Duration = 3}) end
        end
    end
})

VehicleTab:Divider()
end -- cierra do del BUY/VEHICLE tab

