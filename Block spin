local function getPing()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return 0.2 end
    local networkStats = playerGui:FindFirstChild("NetworkStats")
    if not networkStats then return 0.2 end
    local pingLabel = networkStats:FindFirstChild("PingLabel")
    if not pingLabel then return 0.2 end
    local text = pingLabel.Text
    if typeof(text) ~= "string" then return 0.2 end
    local ping = tonumber(text:match("%d+"))
    if not ping then return 0.2 end
    local seconds = ping / 1000
    if seconds < 0 or seconds > 2 then seconds = 0.2 end
    return seconds
end

local function isPlayerExcluded(name)
    for _, friend in ipairs(Config.FriendsList) do
        if friend ~= "" and string.find(string.lower(name), string.lower(friend)) then
            return true
        end
    end
    return false
end

local function getClosestTarget()
    local closest
    local minDist = State.FOV
    if not Camera then return nil end
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local head = player.Character:FindFirstChild("Head")
            local hum = player.Character:FindFirstChild("Humanoid")
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if head and hum and hum.Health > 0 and hrp then
                local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                    if dist <= State.FOV and not isPlayerExcluded(player.Name) then
                        if dist < minDist then
                            minDist = dist
                            closest = player
                        end
                    end
                end
            end
        end
    end
    return closest
end

local function GetSmoothedPing()
    local PingStats = Stats.Network.ServerStatsItem["Data Ping"]
    local pingValue = PingStats:GetValue()
    table.insert(State.PingHistory, pingValue)
    if #State.PingHistory > State.MaxHistory then
        table.remove(State.PingHistory, 1)
    end
    local sum = 0
    for _, val in ipairs(State.PingHistory) do
        sum = sum + val
    end
    return (sum / #State.PingHistory) / 1000
end

local function isBehindWall(fromPos, toPos)
    local direction = toPos - fromPos
    if direction.Magnitude < 1 then return false end
    local ignore = {}
    local char = LocalPlayer.Character
    if char then table.insert(ignore, char) end
    local targetChar = State.CurrentTarget and State.CurrentTarget.Character
    if targetChar then table.insert(ignore, targetChar) end
    local ray = Workspace:Raycast(fromPos, direction, RaycastParams.new())
    if not ray then return false end
    return ray.Instance and not table.find(ignore, ray.Instance.Parent)
end

