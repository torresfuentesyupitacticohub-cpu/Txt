end

-- Создание Billboard для игрока
local function createBillboardForPlayer(player)
    if not ItemsESPEnabled or player == LocalPlayer then return end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if PlayerBillboards[player] then
        PlayerBillboards[player]:Destroy()
        PlayerBillboards[player] = nil
    end
    local billboard = Instance.new("BillboardGui")
    billboard.Adornee = hrp
    billboard.Size = UDim2.new(0, 90, 0, 20)
    billboard.StudsOffset = Vector3.new(0, -5, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = char
    billboard:ClearAllChildren()
    local layout = Instance.new("UIListLayout", billboard)
    layout.FillDirection = Enum.FillDirection.Horizontal
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 5)
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    local tools = {}
    for _, containerName in ipairs{"Backpack", "StarterGear", "StarterPack"} do
        local container = player:FindFirstChild(containerName)
        if container then
            for _, tool in ipairs(container:GetChildren()) do
                if tool:IsA("Tool") and tool.Name ~= "Fists" then
                    table.insert(tools, tool)
                end
            end
        end
    end
    if char then
        for _, tool in ipairs(char:GetChildren()) do
            if tool:IsA("Tool") and tool.Name ~= "Fists" then
                table.insert(tools, tool)
            end
        end
    end
    for _, tool in ipairs(tools) do
        local info = getWeaponInfo(tool)
        if info then
            local image = Instance.new("ImageLabel", billboard)
            image.Size = UDim2.new(0, 20, 0, 20)
            image.BackgroundTransparency = 0.1
            image.Image = info.ImageId
            image.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            Instance.new("UICorner", image).CornerRadius = UDim.new(0, 5)
            local stroke = Instance.new("UIStroke", image)
            stroke.Color = RarityColors[info.Rarity] or Color3.new(1, 1, 1)
            stroke.Thickness = 2
        end
    end
    PlayerBillboards[player] = billboard
end

