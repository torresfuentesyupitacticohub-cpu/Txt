-- Безопасный вызов
local function SafeCall(func, ...)
    local success, result = pcall(func, ...)
    return success, result
end

local unpackFunc = table.unpack or unpack

-- Вызов Remote
local function CallRemote(remote, ...)
    if not remote then return end
    local args = {...}
    if remote.ClassName == "RemoteEvent" then
        if CounterTable and type(CounterTable.event) == "number" then
            CounterTable.event = CounterTable.event + 1
            SafeCall(function(...) remote:FireServer(CounterTable.event, ...) end, unpackFunc(args))
        else
            local counter = (counter or 0) + 1
            SafeCall(function(...) remote:FireServer(counter, ...) end, unpackFunc(args))
        end
    elseif remote.ClassName == "RemoteFunction" then
        if CounterTable and type(CounterTable.func) == "number" then
            CounterTable.func = CounterTable.func + 1
            SafeCall(function(...) remote:InvokeServer(CounterTable.func, ...) end, unpackFunc(args))
        else
            local counter = (counter or 0) + 1
            SafeCall(function(...) remote:InvokeServer(counter, ...) end, unpackFunc(args))
        end
    else
        SafeCall(function(...)
            if remote.FireServer then remote:FireServer(...)
            elseif remote.InvokeServer then remote:InvokeServer(...) end
        end, unpackFunc(args))
    end
end

-- Игроки в радиусе
local function getPlayersInRange(range)
    local result = {}
    local char = LocalPlayer.Character
    if not char or not char.PrimaryPart then return result end
    local myPos = char.PrimaryPart.Position
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character.PrimaryPart then
            local success, dist = pcall(function()
                return (player.Character.PrimaryPart.Position - myPos).Magnitude
            end)
            if success and dist and dist <= range then
                table.insert(result, player)
            end
        end
    end
    return result
end

