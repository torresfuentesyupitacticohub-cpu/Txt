-- ✅ Eliminar puertas (puertas normales + puertas de carros)
-- =============================================
do
    bk:Section({Title = "Doors"})

    local doorRemoverConnection
    local doorRemoverActive = false
    local windowRemoverConnection = nil

    local function isDoor(bx)
        if not bx or not bx:IsA("BasePart") then return false end
        local by = string.lower(bx.Name)
        if by == "door" or by == "doors" or by == "gate" then return true end
        if string.find(by, "door") then return true end
        if string.match(by, "^door[lr][fr]$") then return true end
        if string.match(by, "^door[flr]+$") then return true end
        if by == "trunk" or by == "hood" or by == "hooddoor" or by == "trunkdoor" then return true end
        return false
    end

    -- ✅ Detectar ventanas (windshield, side windows, rear windows, etc.)
    local function isWindow(bx)
        if not bx or not bx:IsA("BasePart") then return false end
        local by = string.lower(bx.Name)
        -- Nombres comunes de ventanas de carro
        if by == "window" or by == "windows" or by == "windshield" or by == "windscreen" then return true end
        if by == "rearwindow" or by == "backwindow" or by == "frontwindow" then return true end
        -- Ventanas con sufijo L/R/F/B (Left, Right, Front, Back)
        if string.match(by, "^window[lr]f?$") then return true end
        if string.match(by, "^window[lr]b$") then return true end
        if string.match(by, "^windshieldl$") or string.match(by, "^windshieldr$") then return true end
        if string.match(by, "^window_front$") or string.match(by, "^window_rear$") then return true end
        if string.match(by, "^window_left$") or string.match(by, "^window_right$") then return true end
        -- Ventanas de edificios
        if by == "glass" or by == "windowpane" or by == "glasspane" then return true end
        -- Cualquier cosa que tenga "window" o "windshield" en el nombre
        if string.find(by, "window") then return true end
        if string.find(by, "windshield") then return true end
        if string.find(by, "windscreen") then return true end
        return false
    end

    local function removePart(bx)
        pcall(function()
            bx.CanCollide = false
            bx.Transparency = 1
            bx.CanQuery = false
            bx:Destroy()
        end)
        return true
    end

    local function removeDoor(bx)
        if isDoor(bx) then return removePart(bx) end
        return false
    end

    local function removeWindow(bx)
        if isWindow(bx) then return removePart(bx) end
        return false
    end

    local function removeAllDoors()
        local removed = 0
        for _, by in ipairs(g:GetDescendants()) do
            if isDoor(by) then
                if removePart(by) then removed = removed + 1 end
            end
        end
        return removed
    end

    local function removeAllWindows()
        local removed = 0
        for _, by in ipairs(g:GetDescendants()) do
            if isWindow(by) then
                if removePart(by) then removed = removed + 1 end
            end
        end
        return removed
    end

    bk:Button({
        Title = "🚪 Remove All Doors",
        Desc = "Elimina puertas del mapa y de carros (1 vez)",
        Callback = function()
            local removed = removeAllDoors()
            if A then
                A:Notify({Title = "🚪 Puertas Eliminadas", Description = "Removidas: " .. tostring(removed), Duration = 3})
            end
        end
    })

    bk:Button({
        Title = "🪟 Remove All Windows",
        Desc = "Elimina ventanas del mapa y de carros (1 vez)",
        Callback = function()
            local removed = removeAllWindows()
            if A then
                A:Notify({Title = "🪟 Ventanas Eliminadas", Description = "Removidas: " .. tostring(removed), Duration = 3})
            end
        end
    })

    bk:Button({
        Title = "🪟🚪 Remove Doors + Windows",
        Desc = "Elimina puertas y ventanas (todo a la vez)",
        Callback = function()
            local dr = removeAllDoors()
            local wr = removeAllWindows()
            if A then
                A:Notify({Title = "🧹 Limpieza Completa", Description = "Puertas: " .. dr .. " | Ventanas: " .. wr, Duration = 3})
            end
        end
    })

    bk:Toggle({
        Title = "🚪 Auto Remove Doors",
        Desc = "Elimina puertas nuevas automáticamente",
        Default = false,
        Callback = function(bx)
            doorRemoverActive = bx
            if doorRemoverConnection then
                pcall(function() doorRemoverConnection:Disconnect() end)
                doorRemoverConnection = nil
            end
            if bx then
                removeAllDoors()
                doorRemoverConnection = g.DescendantAdded:Connect(function(by)
                    if doorRemoverActive and isDoor(by) then
                        task.wait(0.1)
                        removePart(by)
                    end
                end)
                if A then A:Notify({Title = "✅ Auto Remove Doors ON", Description = "Puertas nuevas se eliminarán", Duration = 3}) end
            else
                if A then A:Notify({Title = "❌ Auto Remove Doors OFF", Duration = 3}) end
            end
        end
    })

    bk:Toggle({
        Title = "🪟 Auto Remove Windows",
        Desc = "Elimina ventanas nuevas automáticamente",
        Default = false,
        Callback = function(bx)
            local windowRemoverActive = bx
            if windowRemoverConnection then
                pcall(function() windowRemoverConnection:Disconnect() end)
                windowRemoverConnection = nil
            end
            if bx then
                removeAllWindows()
                windowRemoverConnection = g.DescendantAdded:Connect(function(by)
                    if windowRemoverActive and isWindow(by) then
                        task.wait(0.1)
                        removePart(by)
                    end
                end)
