local function findHealTool()
    local places = {LocalPlayer.Backpack, LocalPlayer.Character, LocalPlayer:FindFirstChild("Inventory"), LocalPlayer:FindFirstChild("StarterGear")}
    for _, place in pairs(places) do
        if place then
            for _, tool in pairs(place:GetChildren()) do
                if tool:IsA("Tool") and (tool:GetAttribute("HealthRestoreAmount") or tool:GetAttribute("HealAmount") or tool:GetAttribute("RestoreHealth")) then
                    return tool
                end
            end
        end
    end
