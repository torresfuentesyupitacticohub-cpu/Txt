-- Silent Aim Logic (Simplified Drawing & Hook)
local Camera = Workspace.CurrentCamera
local FOVCircle = Drawing.new("Circle")
FOVCircle.Thickness = 2
FOVCircle.Color = Color3.fromRGB(255, 255, 255)
FOVCircle.NumSides = 30
FOVCircle.Filled = false
FOVCircle.Visible = false

local TracerLine = Drawing.new("Line")
TracerLine.Thickness = 1.5
TracerLine.Color = Color3.fromRGB(255, 0, 0)
TracerLine.Visible = false

local function GetClosestTarget()
    local closest = nil
    local shortestDist = math.huge
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local head = player.Character:FindFirstChild("Head")
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            local hum = player.Character:FindFirstChild("Humanoid")
            
            if head and hrp and hum and hum.Health > 0 then
                local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if dist <= (_G.FOVRadius or 120) then
                        local mag = (head.Position - RootPart.Position).Magnitude
                        if mag < shortestDist then
                            shortestDist = mag
                            closest = player
                        end
                    end
                end
            end
        end
    end
    return closest
end

-- Hook FireServer for Silent Aim
local oldFireServer
oldFireServer = hookfunction(ReplicatedStorage.Remotes.Send.FireServer, newcclosure(function(self, ...)
    local args = {...}
    
    -- Wallbang Logic (Injecting into shoot_gun usually requires modifying raycast params, 
    -- but here we assume the game handles collision checks server-side or via args. 
    -- The original script modified args[4] and args[5]. We replicate that.)
    
    if _G.SilentAimEnabled and args[2] == 'shoot_gun' then
        local target = GetClosestTarget()
        if target and target.Character then
            local partToAim = target.Character:FindFirstChild(_G.TargetMode == "Smart" and "Head" or _G.TargetMode) or target.Character.Head
            
            -- Calculate prediction/aim position
            local aimPos = partToAim.Position
            
            -- Modify CFrame argument (usually index 4 or similar depending on game version)
            -- Note: Exact indices depend on the specific game's remote structure. 
            -- Based on original script: args[4] is CFrame, args[5] is Raycast result table.
            
            if args[4] and typeof(args[4]) == "CFrame" then
                 local myHead = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head")
                 local myPos = myHead and myHead.Position or Camera.CFrame.Position
                 args[4] = CFrame.new(myPos, aimPos)
            end
            
            if args[5] and typeof(args[5]) == "table" then
                 args[5] = {
                    [1] = {
                        [1] = {
                            Instance = partToAim,
                            Normal = Vector3.new(0, 1, 0),
                            Position = aimPos,
                        },
                    },
                 }
            end
        end
    end
    
    return oldFireServer(self, unpack(args))
end))

