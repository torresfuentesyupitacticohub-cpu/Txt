-- Атака ближайших
local function AttackNearby()
    if not SendRemote then return end
    local char = LocalPlayer.Character
    if not char or not char.PrimaryPart then return end
    local tool = getActiveTool()
    if not tool or not isMeleeTool(tool) then return end
    local success, parent = pcall(function() return tool.Parent end)
    if not success or parent ~= LocalPlayer.Character then return end
    local players = getPlayersInRange(20)
    if #players == 0 then return end
    local success2, myPos = pcall(function() return char.PrimaryPart.Position end)
    if not success2 or not myPos then return end
    local targets = {}
    local positions = {}
    for _, player in pairs(players) do
        if player and player.Character and player.Character.PrimaryPart then
            local head = player.Character:FindFirstChild("Head")
            local hrp = player.Character.PrimaryPart
            if head and hrp then
                local predicted = predictPosition(head, hrp)
                table.insert(targets, player)
                table.insert(positions, predicted)
            end
        end
    end
    if #targets == 0 then return end
    local firstPos = positions[1]
    local lookCFrame = CFrame.lookAt(myPos, firstPos)
    local args = {"melee_attack", tool, targets, lookCFrame, 0.75}
    pcall(function() CallRemote(SendRemote, unpackFunc(args)) end)
end

