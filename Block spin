FishTab:Button({
    Title = "Auto Hack ATMs I Fish",
    Desc = "Automatically hits the slider minigame when fishing",
    Callback = function()
        local ReplicatedStorage = game:GetService("ReplicatedStorage")
        local VirtualInputManager = game:GetService("VirtualInputManager")
        local RunService = game:GetService("RunService")
        local CoreGui = (gethui and gethui()) or game:GetService("CoreGui")
        local autoEnabled = false
        local renderConn, dragConn
        local lastClick = 0
        local SliderMinigame
        local ok, err = pcall(function()
            SliderMinigame = require(ReplicatedStorage.Modules.Game.Minigames.SliderMinigame)
        end)
        if not ok then warn("Failed to load SliderMinigame:", err) end
        local function autoHit()
            pcall(function()
                if not (SliderMinigame and SliderMinigame.enabled and SliderMinigame.enabled.get()) then
                    return
                end
                local needle = SliderMinigame.needle_pos.get()
                local target = SliderMinigame.target_pos.get()
                local size = SliderMinigame.target_size.get()
                local tolerance = (type(size) == "number" and size > 0) and (size / 2) * 0.7 or 0.02
                if math.abs(needle - target) <= tolerance and tick() - lastClick > 0.5 then
                    lastClick = tick()
                    local cam = workspace.CurrentCamera
                    local x, y = cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2
                    VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
                    task.wait(0.03)
                    VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
                end
            end)
        end
        if renderConn then
            renderConn:Disconnect()
        end
        autoEnabled = true
        renderConn = RunService.RenderStepped:Connect(function()
            if autoEnabled then autoHit() end
        end)
        if WindUI then
            WindUI:Notify({Title = "✅ Auto Fish Hack Activated", Duration = 3})
        end
    end
})
