local function getClosestTarget()
    if not F then return nil end
    local closest, closestDist = nil, H
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local hum = char:FindFirstChild("Humanoid")
            local head = char:FindFirstChild("Head")
            if hum and hum.Health > 0 and head then
                local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local dist2D = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                    if dist2D <= H and dist2D < closestDist then
                        closestDist = dist2D
                        closest = player
                    end
                end
            end
        end
    end
    return closest
end

-- ==========================================
-- CAR SNAP SYSTEM
-- ==========================================
local CarSnapSystem = {
    PlatformEnabled = false,
    Platform = nil,
    PlatformSize = Vector3.new(20, 1.5, 10),
    PlatformOffset = Vector3.new(0, -3, 0),
    PlatformConnection = nil,
    SnapDownEnabled = false,
    SnapUpEnabled = false,
    MaxDepthDown = 15,
    MaxHeightUp = 3,
    CurrentDepthDown = 0,
    CurrentHeightUp = 0,
    OriginalHeight = nil,
    GuideActive = false,
    GuideFrame = nil
}

local function FindVehicle()
    local Vehicles = Workspace:FindFirstChild("Vehicles")
    if not Vehicles then return nil end
    for _, Vehicle in ipairs(Vehicles:GetChildren()) do
        if Vehicle:GetAttribute("OwnerUserId") == LocalPlayer.UserId then
            return Vehicle
        end
    end
    local Character = LocalPlayer.Character
    if Character then
        local Humanoid = Character:FindFirstChildOfClass("Humanoid")
        if Humanoid and Humanoid.SeatPart then
            return Humanoid.SeatPart.Parent
        end
    end
    return nil
end

local function getChassis()
    local car = FindVehicle()
    if not car then return nil end
    local chassis = car:FindFirstChild("Chassis")
    if not chassis then
        for _, child in ipairs(car:GetChildren()) do
            if child:IsA("BasePart") then chassis = child; break end
        end
    end
    return chassis
end

local function createFollowingPlatform()
    if CarSnapSystem.Platform then CarSnapSystem.Platform:Destroy() end
    
    local part = Instance.new("Part")
    part.Name = "CarFollowPlatform"
    part.Size = CarSnapSystem.PlatformSize
    part.Anchored = true
    part.CanCollide = true
    part.Material = Enum.Material.Neon
    part.Color = Color3.fromRGB(0, 170, 255)
    part.Transparency = 0.2
    part.TopSurface = Enum.SurfaceType.Smooth
    part.BottomSurface = Enum.SurfaceType.Smooth
    part.Parent = Workspace
    
    CarSnapSystem.Platform = part
    return part
end

local function startPlatformLoop()
    if CarSnapSystem.PlatformConnection then
        CarSnapSystem.PlatformConnection:Disconnect()
    end
    
    CarSnapSystem.PlatformConnection = RunService.Heartbeat:Connect(function()
        if not CarSnapSystem.PlatformEnabled then return end
        
        local chassis = getChassis()
        if not chassis then return end
        
        if not CarSnapSystem.Platform or not CarSnapSystem.Platform.Parent then
            createFollowingPlatform()
        end
        
        local carPos = chassis.Position
        local newPos = carPos + CarSnapSystem.PlatformOffset
        CarSnapSystem.Platform.CFrame = CFrame.new(newPos)
    end)
end

local function stopPlatform()
    CarSnapSystem.PlatformEnabled = false
    if CarSnapSystem.PlatformConnection then
        CarSnapSystem.PlatformConnection:Disconnect()
        CarSnapSystem.PlatformConnection = nil
    end
    if CarSnapSystem.Platform then
        CarSnapSystem.Platform:Destroy()
        CarSnapSystem.Platform = nil
    end
end

local function snapDown()
    local chassis = getChassis()
    if not chassis then return end
    
    if not CarSnapSystem.OriginalHeight then
        CarSnapSystem.OriginalHeight = chassis.Position.Y
    end
    
    local targetY = CarSnapSystem.OriginalHeight - CarSnapSystem.CurrentDepthDown
    local pos = chassis.Position
    chassis.CFrame = CFrame.new(pos.X, targetY, pos.Z) * CFrame.Angles(chassis.CFrame:ToEulerAnglesXYZ())
end

local function snapUp()
    local chassis = getChassis()
    if not chassis then return end
    
    if not CarSnapSystem.OriginalHeight then
        CarSnapSystem.OriginalHeight = chassis.Position.Y
    end
    
    local targetY = CarSnapSystem.OriginalHeight + CarSnapSystem.CurrentHeightUp
    local pos = chassis.Position
    chassis.CFrame = CFrame.new(pos.X, targetY, pos.Z) * CFrame.Angles(chassis.CFrame:ToEulerAnglesXYZ())
end

