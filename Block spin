-- Попытка пропуска крата
local function TrySkipCrate()
    local success, crateModule = pcall(function()
        return require(ReplicatedStorage.Modules.Game.CrateSystem.Crate)
    end)
    if not (success and crateModule) then return end
    task.spawn(function()
        local spinning = crateModule.spinning
        if not spinning then return end
        local elapsed = 0
        while not spinning.get() do
            if elapsed > 3 then break end
            task.wait(0.05)
            elapsed = elapsed + 0.05
        end
        if spinning.get() then
            pcall(function() crateModule.skip_spin() end)
        end
    end)
end

-- Настройка авто-пропуска
local function SetupAutoSkip()
    local remotes = ReplicatedStorage:WaitForChild("Remotes", 5)
    if not remotes then return end
    local send = remotes:WaitForChild("Send", 5)
    if not (send and send:IsA("RemoteEvent")) then return end
    send.OnClientEvent:Connect(function(...)
        if AutoSkipEnabled then TrySkipCrate() end
    end)
end

-- Создание ESP
local function createESP(player)
    if ESPCache[player] then return end
    local nameText = Drawing.new("Text")
    nameText.Size = 16
    nameText.Center = true
    nameText.Outline = true
    nameText.Color = isPlayerExcluded(player.Name) and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 255, 255)
    nameText.Font = 4
    local distText = Drawing.new("Text")
    distText.Size = 14
    distText.Center = true
    distText.Outline = true
    distText.Color = Color3.fromRGB(255, 255, 255)
    distText.Font = 4
    local healthBg = Drawing.new("Square")
    healthBg.Filled = false
    healthBg.Thickness = 1
    healthBg.Color = Color3.fromRGB(0, 0, 0)
    healthBg.Transparency = 0.9
    healthBg.Visible = false
    local healthFill = Drawing.new("Square")
    healthFill.Filled = true
    healthFill.Transparency = 0.9
    healthFill.Visible = false
    local drawings = {nameText, distText, healthBg, healthFill}
    local conn = RunService.RenderStepped:Connect(function()
        if not player or not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
            for _, d in pairs(drawings) do d.Visible = false end
            return
        end
        local hrp = player.Character.HumanoidRootPart
        local hum = player.Character:FindFirstChild("Humanoid")
        local dist = 0
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            dist = (hrp.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
        end
        local screenPos, onScreen = workspace.CurrentCamera:WorldToViewportPoint(hrp.Position)
        if not onScreen or screenPos.Z <= 0 then
            for _, d in pairs(drawings) do d.Visible = false end
            return
        end
        local x = screenPos.X
        local y = screenPos.Y - 15
        if HealthESPEnabled and hum and hum.Health > 0 then
            local healthPct = hum.Health / (hum.MaxHealth > 0 and hum.MaxHealth or 1)
            local barHeight = 4
            local barWidth = 60
            local barX = x - barWidth / 2
            healthBg.Position = Vector2.new(barX, y - barHeight - 2)
            healthBg.Size = Vector2.new(barWidth, barHeight)
            healthBg.Visible = true
            healthFill.Position = Vector2.new(barX, y - barHeight - 2)
            healthFill.Size = Vector2.new(barWidth * healthPct, barHeight)
            healthFill.Color = Color3.fromHSV(healthPct * 0.333, 0.8, 0.9)
            healthFill.Visible = true
            y = y - barHeight - 6
        else
            healthBg.Visible = false
            healthFill.Visible = false
        end
        if NameESPEnabled then
            local minSize, maxSize = 14, 42
            local scale = math.clamp(dist / 50, 0, 1)
            local size = maxSize - (maxSize - minSize) * scale
            nameText.Text = player.Name
            nameText.Size = math.floor(size)
            nameText.Color = isPlayerExcluded(player.Name) and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 255, 255)
            nameText.Outline = true
            nameText.Position = Vector2.new(x, y - 16)
            nameText.Visible = true
        else
            nameText.Visible = false
        end
        distText.Text = DistanceESPEnabled and string.format("%.0f studs", dist) or ""
        distText.Position = Vector2.new(x, screenPos.Y + 20)
        distText.Visible = DistanceESPEnabled
    end)
    ESPCache[player] = {conn = conn, drawings = drawings}
end

-- Загрузка ESP
local function loadESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and not ESPCache[player] then createESP(player) end
    end
    Players.PlayerAdded:Connect(function(player)
        if player ~= LocalPlayer then
            player.CharacterAdded:Connect(function()
                task.wait(0.1)
                if not ESPCache[player] then createESP(player) end
            end)
            if player.Character and not ESPCache[player] then
                task.wait(0.1)
                createESP(player)
            end
        end
    end)
    Players.PlayerRemoving:Connect(function(player)
        if ESPCache[player] then
            for _, d in pairs(ESPCache[player].drawings) do
                if d and d.Destroy then pcall(function() d:Destroy() end)
                elseif typeof(d) == "table" and d.Visible ~= nil then d.Visible = false end
            end
            if ESPCache[player].conn then pcall(function() ESPCache[player].conn:Disconnect() end) end
        end
    end)
end

